# Public site URL used for canonical links, OG images, sitemap
NEXT_PUBLIC_SITE_URL=https://buckberrylabs.com

# Resend API key for contact form delivery
RESEND_API_KEY=

# Contact form routing
CONTACT_EMAIL_TO=info@buckberrylabs.com
CONTACT_EMAIL_FROM=Buckberry Labs <info@send.buckberrylabs.com>

# Cal.com username for booking embed
CAL_USERNAME=

# Plausible analytics domain (set to your production domain when enabling)
PLAUSIBLE_DOMAIN=buckberrylabs.com
